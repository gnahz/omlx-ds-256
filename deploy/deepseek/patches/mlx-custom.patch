+void qualified_gather_qmm_rhs_nax(
+    const array& x_,
+    const array& w_,
+    const array& scales_,
+    const std::optional<array>& biases_,
+    const std::optional<array>& global_scale,
+    const array& indices_,
+    array& out,
+    bool transpose,
+    int group_size,
+    int bits,
+    int M,
+    int N,
+    int K,
+    metal::Device& d,
+    const Stream& s,
+    const std::string mode,
+    const std::optional<array>& x_rows_ = std::nullopt) {
+  // Start by normalizing the indices
+  array indices = ensure_row_contiguous(indices_, d, s);
+
+  // Broadcast x with indices. If we are here that means lhs_indices were not
+  // provided so the lhs_indices are implied to be the shape of x broadcasted
+  // with rhs_indices. We need only broadcast x and copy it as if applying the
+  // lhs_indices.
+  auto broadcast_with_indices = [&d, &s, &indices](const array& x) {
+    if (x.size() / x.shape(-2) / x.shape(-1) == indices.size()) {
+      return ensure_row_contiguous(x, d, s);
+    }
+
+    auto x_shape = indices.shape();
+    x_shape.push_back(x.shape(-2));
+    x_shape.push_back(x.shape(-1));
+    array new_x(std::move(x_shape), x.dtype(), nullptr, {});
+    broadcast(x, new_x);
+    return ensure_row_contiguous(new_x, d, s);
+  };
+
+  // Normalize the input arrays. With x_rows, the kernel reads row x_rows[r]
+  // of x for row r of the product, so x is not broadcast.
+  const bool gather_x = x_rows_.has_value();
+  array x = gather_x ? ensure_row_contiguous(x_, d, s) : broadcast_with_indices(x_);
+  array w = ensure_row_contiguous(w_, d, s);
+  array scales = ensure_row_contiguous(scales_, d, s);
+  std::optional<array> biases;
+  if (biases_) {
+    biases = ensure_row_contiguous(*biases_, d, s);
+  }
+  std::optional<array> gs;
+  if (global_scale) {
+    gs = ensure_row_contiguous(*global_scale, d, s);
+  }
+
+  // Use smaller bm for many experts and few tokens.
+  int E = w.size() / w.shape(-1) / w.shape(-2);
+  int bm = (M / E < 64) ? 32 : 64;
+  int bn = 64, bk = 64;
+  int wm = 2, wn = 2;
+
+  // Expert-aligned row tiles: each threadgroup multiplies rows of one expert
+  // only, so no weight tile is dequantized for a partial expert segment. Four
+  // simdgroups of 16 rows keep the partial last tile of an expert cheap.
+  // A K block of 128 halves the threadgroup barriers per K.
+  const bool use_tiles = transpose &&
+      (mode != "affine" || ((bits == 2 || bits == 3) && group_size == 128));
+  if (use_tiles) {
+    bm = 64;
+    bk = (K % 128 == 0) ? 128 : 64;
+    wm = 4;
+    wn = 1;
